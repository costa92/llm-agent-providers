    "body": "{\n      \"id\":\"msg_tool_1\",\n      \"type\":\"message\",\n      \"role\":\"assistant\",\n      \"model\":\"claude-3-5-haiku-20241022\",\n      \"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_calc\",\"name\":\"calculator\",\"input\":{\"expr\":\"2+2\"},\"caller\":{\"type\":\"direct\"}}],\n      \"stop_reason\":\"tool_use\",\n      \"stop_sequence\":null,\n      \"usage\":{\"input_tokens\":10,\"output_tokens\":4}\n    }"
  },
  "expect": {
